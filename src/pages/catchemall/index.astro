---
import SiteLayout from "../../components/layout/SiteLayout.astro";

const pageTitle = "Catch 'em all | Vivek Raman";
const description = "wannab's Pokémon dex progress from Pokedex Tracker.";
const canonical = new URL("catchemall/", Astro.site ?? "https://vivekraman.dev");
---

<SiteLayout
  pageTitle={pageTitle}
  description={description}
  canonicalUrl={canonical.href}
  wrapperClass="catchemall-layout"
  breadcrumbs={[{ label: "Catch 'em all" }]}
>
  <main class="catchemall" aria-labelledby="catchemall-title">
    <header class="catchemall__header">
      <p class="catchemall__eyebrow">Pokedex Tracker</p>
      <h1 id="catchemall-title">Catch 'em all</h1>
      <p>wannab's Pokémon Home and Pokémon Go progress, updated from Pokedex Tracker.</p>
    </header>

    <section aria-live="polite" aria-busy="true" id="dexes">
      <p class="catchemall__status">Loading dexes...</p>
    </section>
  </main>

  <template id="region-card-template">
    <details class="region-card">
      <summary>
        <span class="region-card__identity">
          <span class="region-card__title"></span>
          <span class="region-card__generation"></span>
        </span>
        <span class="region-card__collection-progress"></span>
      </summary>
      <div class="region-card__body">
        <p></p>
        <ul class="region-card__pokemon"></ul>
      </div>
    </details>
  </template>

  <script>
    type Dex = {
      title: string;
      caught: number;
      total: number;
      shiny: boolean;
      slug?: string;
      dex_type?: { name?: string };
      game?: { name?: string };
    };

    type User = { dexes?: Dex[] };
    type Capture = {
      captured: boolean;
      pokemon: {
        dex_number?: number;
        national_id?: number;
        form?: string | null;
        game_family?: { generation?: number };
        name: string;
      };
    };

    type Collection = {
      key: string;
      label: string;
      dexSlug: string;
      dex?: Dex;
      captures: Map<string, Capture>;
    };

    // Add a collection here to give every Pokémon another caught-state icon.
    const collectionMap = [
      { key: "home", label: "Pokémon Home", dexSlug: "allllll" },
      { key: "go", label: "Pokémon Go", dexSlug: "go" },
    ] as const;

    const regions = new Map([
      [1, "Kanto"],
      [2, "Johto"],
      [3, "Hoenn"],
      [4, "Sinnoh"],
      [5, "Unova"],
      [6, "Kalos"],
      [7, "Alola"],
      [8, "Galar"],
      [9, "Paldea"],
    ]);

    const container = document.querySelector<HTMLElement>("#dexes");
    const regionCardTemplate = document.querySelector<HTMLTemplateElement>("#region-card-template");

    const renderStatus = (message: string) => {
      if (container) container.innerHTML = `<p class="catchemall__status">${message}</p>`;
    };

    const captureKey = (capture: Capture) =>
      String(
        capture.pokemon.national_id ??
          capture.pokemon.dex_number ??
          `${capture.pokemon.name}-${capture.pokemon.form ?? ""}`
      );

    const collectionPercentage = (captures: Capture[]) => {
      const caught = captures.filter((capture) => capture.captured).length;
      return captures.length ? Math.round((caught / captures.length) * 100) : 0;
    };

    const renderCollectionSummary = (collections: Collection[], target: HTMLElement) => {
      const summary = document.createElement("section");
      summary.className = "collection-summary";
      summary.setAttribute("aria-label", "Collection progress");

      for (const collection of collections) {
        const caught = [...collection.captures.values()].filter(({ captured }) => captured).length;
        const total = collection.captures.size;
        const percentage = total ? Math.round((caught / total) * 100) : 0;
        const item = document.createElement("div");
        item.className = "collection-summary__item";
        item.dataset.collectionKey = collection.key;
        item.innerHTML = `<span class="collection-summary__label"></span><strong></strong><span class="collection-summary__track" aria-hidden="true"><span></span></span>`;
        const label = item.querySelector<HTMLElement>(".collection-summary__label");
        const count = item.querySelector<HTMLElement>("strong");
        const track = item.querySelector<HTMLElement>(".collection-summary__track > span");
        if (label) label.textContent = collection.label;
        if (count) count.textContent = `${caught.toLocaleString()} / ${total.toLocaleString()}`;
        if (track) track.style.width = `${percentage}%`;
        summary.append(item);
      }
      target.append(summary);
    };

    const renderRegions = (captures: Capture[], collections: Collection[], target: HTMLElement) => {
      if (!regionCardTemplate) return;

      const section = document.createElement("section");
      section.className = "region-collection";
      section.setAttribute("aria-label", "Collection by region");
      const heading = document.createElement("h3");
      heading.textContent = "Collection by region";
      section.append(heading);

      const grouped = new Map<number, Capture[]>();
      for (const capture of captures) {
        const generation = capture.pokemon.game_family?.generation;
        if (!generation || !regions.has(generation)) continue;
        grouped.set(generation, [...(grouped.get(generation) ?? []), capture]);
      }

      for (const [generation, name] of regions) {
        const collection = grouped.get(generation);
        if (!collection?.length) continue;
        const total = collection.length;
        const card = regionCardTemplate.content.cloneNode(true) as DocumentFragment;
        const title = card.querySelector<HTMLElement>(".region-card__title");
        const regionGeneration = card.querySelector<HTMLElement>(".region-card__generation");
        const details = card.querySelector<HTMLElement>(".region-card__body p");
        const regionProgress = card.querySelector<HTMLElement>(".region-card__collection-progress");
        const pokemonList = card.querySelector<HTMLUListElement>(".region-card__pokemon");
        if (title) title.textContent = name;
        if (regionGeneration) regionGeneration.textContent = `Generation ${generation}`;
        if (details) details.textContent = `${total.toLocaleString()} Pokémon`;
        if (regionProgress) {
          for (const collectionDefinition of collections) {
            const regionCaptures = collection
              .map((capture) => collectionDefinition.captures.get(captureKey(capture)))
              .filter((capture): capture is Capture => Boolean(capture));
            const status = document.createElement("span");
            status.className = "region-card__collection-status";
            status.dataset.collectionKey = collectionDefinition.key;
            status.textContent = `${collectionDefinition.label} ${collectionPercentage(regionCaptures)}%`;
            regionProgress.append(status);
          }
        }
        if (pokemonList) {
          for (const capture of collection) {
              const item = document.createElement("li");
              item.className = "region-card__pokemon-item";
              const name = document.createElement("span");
              name.className = "region-card__pokemon-name";
              const number = String(capture.pokemon.dex_number ?? "?").padStart(4, "0");
              name.textContent = `#${number} ${capture.pokemon.name}${
                capture.pokemon.form ? ` (${capture.pokemon.form})` : ""
              }`;
              const statuses = document.createElement("span");
              statuses.className = "region-card__pokemon-statuses";
              for (const collectionDefinition of collections) {
                const collectionCapture = collectionDefinition.captures.get(captureKey(capture));
                const caught = collectionCapture?.captured ?? false;
                const status = document.createElement("span");
                status.className = `region-card__pokemon-status ${caught ? "is-caught" : "is-missing"}`;
                status.dataset.collectionKey = collectionDefinition.key;
                status.setAttribute(
                  "aria-label",
                  `${collectionDefinition.label}: ${caught ? "caught" : "uncaught"}`
                );
                status.title = `${collectionDefinition.label}: ${caught ? "caught" : "uncaught"}`;
                statuses.append(status);
              }
              item.append(name, statuses);
              pokemonList.append(item);
          }
        }
        section.append(card);
      }
      target.append(section);
    };

    const renderDexes = (dexes: Dex[]) => {
      if (!container) return;

      container.replaceChildren();
      container.setAttribute("aria-busy", "false");

      if (dexes.length === 0) {
        renderStatus("No dexes found.");
        return;
      }

      const collections = collectionMap
        .map((definition) => ({
          ...definition,
          dex: dexes.find((dex) => dex.slug === definition.dexSlug),
          captures: new Map<string, Capture>(),
        }))
        .filter((collection) => collection.dex);

      if (!collections.length) {
        renderStatus("The mapped collections were not found.");
        return;
      }

      const panel = document.createElement("div");
      panel.className = "dex-panel";
      const status = document.createElement("p");
      status.className = "region-collection__status";
      status.textContent = "Loading collections...";
      panel.append(status);
      container.append(panel);

      Promise.all(
        collections.map(async (collection) => {
          const response = await fetch(
            `/catchemall/api/users/wannab/dexes/${encodeURIComponent(collection.dexSlug)}/captures`,
            {
              headers: { Accept: "application/json" },
            }
          );
          if (!response.ok) throw new Error("Unable to load captures");
          const captures = (await response.json()) as Capture[];
          collection.captures = new Map(captures.map((capture) => [captureKey(capture), capture]));
        })
      )
        .then(() => {
          status.remove();
          renderCollectionSummary(collections, panel);
          const primaryCollection = collections[0];
          if (primaryCollection) renderRegions([...primaryCollection.captures.values()], collections, panel);
        })
        .catch(() => {
          status.textContent = "The collections are unavailable right now. Please try again shortly.";
        });
    };

    fetch("/catchemall/api/users/wannab", { headers: { Accept: "application/json" } })
      .then((response) => {
        if (!response.ok) throw new Error("Unable to load dexes");
        return response.json() as Promise<User>;
      })
      .then((user) => renderDexes(user.dexes ?? []))
      .catch(() => {
        if (container) container.setAttribute("aria-busy", "false");
        renderStatus("The dexes are unavailable right now. Please try again shortly.");
      });
  </script>
  <style is:global>
    .catchemall-layout {
      flex: 1;
      width: 100%;
    }

    .catchemall {
      --dex-red: #b94737;
      --dex-red-deep: #8e3028;
      --dex-gold: #d39a4b;
      --dex-paper: color-mix(in srgb, var(--color-surface) 82%, #fff 18%);
      position: relative;
      isolation: isolate;
      width: min(100% - 2 * var(--page-pad), var(--content-wide));
      margin: 0 auto;
      padding: clamp(2.5rem, 7vw, 5rem) 0 5rem;
    }

    .catchemall::before,
    .catchemall::after {
      position: absolute;
      z-index: -1;
      width: clamp(10rem, 28vw, 18rem);
      aspect-ratio: 1;
      border: 1px solid color-mix(in srgb, var(--dex-gold) 26%, transparent);
      border-radius: 50%;
      content: "";
      opacity: 0.6;
      pointer-events: none;
    }

    .catchemall::before {
      top: 2.5rem;
      right: -8rem;
      background:
        radial-gradient(circle at center, var(--color-surface) 0 17%, transparent 18% 34%, color-mix(in srgb, var(--dex-gold) 10%, transparent) 35% 36%, transparent 37%),
        linear-gradient(180deg, color-mix(in srgb, var(--dex-red) 13%, transparent) 0 48%, transparent 48% 52%, color-mix(in srgb, var(--color-ink) 8%, transparent) 52%);
    }

    .catchemall::after {
      bottom: 8rem;
      left: -10rem;
      border-color: color-mix(in srgb, var(--dex-red) 20%, transparent);
      background: radial-gradient(circle, transparent 0 54%, color-mix(in srgb, var(--dex-red) 9%, transparent) 55% 56%, transparent 57%);
    }

    @media (prefers-color-scheme: dark) {
      :root:not([data-theme]) .catchemall {
        --dex-red: #d6a452;
        --dex-red-deep: #ab762f;
        --dex-gold: #e8c47d;
        --dex-paper: #28231e;
      }
    }

    :root[data-theme="dark"] .catchemall {
      --dex-red: #d6a452;
      --dex-red-deep: #ab762f;
      --dex-gold: #e8c47d;
      --dex-paper: #28231e;
    }

    .catchemall__header {
      position: relative;
      margin-bottom: 2rem;
    }

    .catchemall__eyebrow,
    .dex-card__game,
    .dex-card__type,
    .dex-card__percent {
      margin: 0;
      color: var(--color-muted);
      font-family: var(--font-mono);
      font-size: 0.78rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .catchemall__eyebrow {
      display: flex;
      align-items: center;
      gap: 0.55rem;
      color: var(--dex-red);
      font-weight: 700;
    }

    .catchemall__eyebrow::before {
      width: 0.65rem;
      height: 0.65rem;
      border: 2px solid currentColor;
      border-radius: 50%;
      box-shadow: inset 0 0 0 2px var(--color-surface);
      content: "";
    }

    .catchemall h1 {
      margin: 0.35rem 0;
      font-family: var(--font-display);
      font-size: clamp(2.5rem, 8vw, 4.75rem);
      font-weight: 600;
      letter-spacing: -0.045em;
      line-height: 1;
    }

    .catchemall__header > p:last-child {
      max-width: 38rem;
      margin: 0;
      color: var(--color-muted);
    }

    .catchemall__status {
      margin: 0;
      padding: 1.25rem;
      color: var(--color-muted);
      border: 1px solid var(--color-stroke);
      border-radius: var(--radius);
      background: color-mix(in srgb, var(--color-surface-2) 55%, transparent);
    }

    .dex-panel {
      display: grid;
      gap: 1.75rem;
      padding: clamp(1.4rem, 4vw, 2.25rem);
      border: 1px solid color-mix(in srgb, var(--dex-gold) 25%, var(--color-stroke));
      border-radius: 1.25rem;
      background:
        linear-gradient(135deg, color-mix(in srgb, var(--dex-paper) 88%, transparent), color-mix(in srgb, var(--color-surface-2) 78%, transparent)),
        var(--dex-paper);
      box-shadow: var(--shadow-lift);
    }

    @media (prefers-color-scheme: dark) {
      :root:not([data-theme]) .dex-panel {
        border-color: color-mix(in srgb, var(--dex-gold) 38%, transparent);
        background: linear-gradient(145deg, #332d27, #24201c);
        box-shadow: 0 1.5rem 3.5rem -2rem #000;
      }

      :root:not([data-theme]) .region-card {
        border-color: color-mix(in srgb, var(--dex-gold) 22%, transparent);
        background: #2a251f;
      }

      :root:not([data-theme]) .region-card[open] {
        background: #211d19;
      }
    }

    :root[data-theme="dark"] .dex-panel {
      border-color: color-mix(in srgb, var(--dex-gold) 38%, transparent);
      background: linear-gradient(145deg, #332d27, #24201c);
      box-shadow: 0 1.5rem 3.5rem -2rem #000;
    }

    :root[data-theme="dark"] .region-card {
      border-color: color-mix(in srgb, var(--dex-gold) 22%, transparent);
      background: #2a251f;
    }

    :root[data-theme="dark"] .region-card[open] {
      background: #211d19;
    }

    .collection-summary {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
      gap: 0.75rem;
    }

    .collection-summary__item {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.45rem 0.75rem;
      padding: 0.85rem 0.95rem;
      border: 1px solid color-mix(in srgb, var(--color-stroke) 75%, transparent);
      border-radius: 0.65rem;
      background: color-mix(in srgb, var(--color-ink) 3%, transparent);
    }

    .collection-summary__label {
      color: var(--color-muted);
      font-size: 0.85rem;
    }

    .collection-summary__item strong {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      font-weight: 500;
    }

    .collection-summary__track {
      grid-column: 1 / -1;
      height: 0.34rem;
      overflow: hidden;
      border-radius: var(--radius-pill);
      background: color-mix(in srgb, var(--color-ink) 12%, transparent);
    }

    .collection-summary__track > span {
      display: block;
      height: 100%;
      border-radius: inherit;
      background: var(--dex-red);
    }

    .collection-summary__item[data-collection-key="go"] .collection-summary__track > span {
      background: #3c78b9;
    }

    .region-collection {
      display: grid;
      gap: 0.6rem;
      padding-top: 1.5rem;
      border-top: 1px dashed color-mix(in srgb, var(--dex-gold) 38%, var(--color-stroke));
    }

    .region-collection h3 {
      margin: 0 0 0.1rem;
      font-family: var(--font-display);
      font-size: 1.4rem;
    }

    .region-collection__status {
      margin: 0;
      color: var(--color-muted);
      font-size: 0.9rem;
    }

    .region-card {
      border: 1px solid color-mix(in srgb, var(--dex-gold) 20%, var(--color-stroke));
      border-radius: 0.8rem;
      background: color-mix(in srgb, var(--color-surface) 76%, transparent);
      transition:
        border-color 160ms ease,
        box-shadow 160ms ease,
        background 160ms ease;
    }

    .region-card:hover {
      border-color: color-mix(in srgb, var(--dex-red) 48%, var(--color-stroke));
      background: var(--color-surface);
    }

    .region-card[open] {
      border-color: color-mix(in srgb, var(--dex-red) 58%, var(--color-stroke));
      box-shadow: 0 0.5rem 1.75rem color-mix(in srgb, var(--color-ink) 8%, transparent);
    }

    .region-card summary {
      display: grid;
      grid-template-columns: minmax(7rem, 1fr) minmax(11rem, 1.2fr) 1rem;
      gap: 1.1rem;
      align-items: center;
      min-height: 4.5rem;
      padding: 0.75rem 1rem 0.75rem 1.15rem;
      cursor: pointer;
      list-style: none;
    }

    .region-card summary::-webkit-details-marker {
      display: none;
    }

    .region-card summary::before {
      grid-column: 3;
      grid-row: 1;
      width: 0.48rem;
      height: 0.48rem;
      border: solid var(--color-muted);
      border-width: 0 2px 2px 0;
      justify-self: end;
      content: "";
      transform: rotate(45deg) translate(-0.1rem, -0.1rem);
      transition: transform 160ms ease;
    }

    .region-card[open] summary::before {
      transform: rotate(-135deg) translate(-0.1rem, -0.1rem);
    }

    .region-card__identity {
      display: grid;
      gap: 0.1rem;
    }

    .region-card__title {
      font-weight: 600;
      font-family: var(--font-display);
      font-size: 1.2rem;
    }

    .region-card__generation,
    .region-card__count small {
      color: var(--color-muted);
      font-size: 0.75rem;
    }

    .region-card__collection-progress {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 0.3rem;
    }

    .region-card__collection-status {
      padding: 0.28rem 0.42rem;
      color: var(--dex-red-deep);
      border-radius: var(--radius-pill);
      background: color-mix(in srgb, var(--dex-red) 11%, transparent);
      font-family: var(--font-mono);
      font-size: 0.68rem;
      white-space: nowrap;
    }

    .region-card__collection-status[data-collection-key="go"] {
      color: #285f9b;
      background: color-mix(in srgb, #3c78b9 12%, transparent);
    }

    .region-card__body {
      display: grid;
      gap: 0.8rem;
      padding: 0 1.15rem 1.15rem;
    }

    .region-card__body p {
      margin: 0;
      color: var(--color-muted);
      font-size: 0.82rem;
    }

    .region-card__pokemon {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
      gap: 0.4rem;
      max-height: min(50vh, 28rem);
      margin: 0;
      padding: 0;
      list-style: none;
      overflow: auto;
      scrollbar-color: var(--color-stroke) transparent;
    }

    .region-card__pokemon-item {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.5rem;
      align-items: center;
      padding: 0.48rem 0.55rem;
      border: 1px solid transparent;
      border-radius: 0.45rem;
      background: color-mix(in srgb, var(--color-ink) 4%, transparent);
      font-size: 0.84rem;
      line-height: 1.25;
    }

    .region-card__pokemon-statuses {
      display: flex;
      gap: 0.3rem;
    }

    .region-card__pokemon-status {
      position: relative;
      display: block;
      width: 1.15rem;
      height: 1.15rem;
      overflow: hidden;
      border: 2px solid currentColor;
      border-radius: 50%;
    }

    .region-card__pokemon-status::before {
      position: absolute;
      top: calc(50% - 1px);
      right: -2px;
      left: -2px;
      height: 2px;
      background: currentColor;
      content: "";
    }

    .region-card__pokemon-status::after {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 0.42rem;
      height: 0.42rem;
      border: 1.5px solid currentColor;
      border-radius: 50%;
      background: var(--color-surface);
      box-shadow: 0 0 0 1px var(--color-surface);
      content: "";
      transform: translate(-50%, -50%);
    }

    .region-card__pokemon-status.is-caught {
      color: var(--color-ink);
      background: linear-gradient(to bottom, var(--color-accent) 0 46%, var(--color-on-accent) 46%);
    }

    .region-card__pokemon-status.is-caught::after {
      background: var(--color-on-accent);
      box-shadow: none;
    }

    .region-card__pokemon-status[data-collection-key="go"].is-caught {
      background: linear-gradient(to bottom, #3c78b9 0 46%, var(--color-on-accent) 46%);
    }

    .region-card__pokemon-status.is-missing {
      color: var(--color-muted);
    }

    @media (max-width: 34rem) {
      .region-card summary {
        grid-template-columns: minmax(0, 1fr) minmax(10rem, 1.1fr) 1rem;
        gap: 0.8rem;
      }

      .region-card summary::before {
        grid-column: 3;
      }

      .region-card__pokemon {
        grid-template-columns: 1fr;
      }
    }
  </style>
</SiteLayout>
