---
import SiteLayout from "../../components/layout/SiteLayout.astro";

const pageTitle = "Catch 'em all | Vivek Raman";
const description = "wannab's Pokémon dex progress from Pokedex Tracker.";
const canonical = new URL("catchemall/", Astro.site ?? "https://vivekraman.dev");
---

<SiteLayout
  pageTitle={pageTitle}
  description={description}
  canonicalUrl={canonical.href}
  wrapperClass="catchemall-layout"
  breadcrumbs={[{ label: "Catch 'em all" }]}
>
  <main class="catchemall" aria-labelledby="catchemall-title">
    <header class="catchemall__header">
      <p class="catchemall__eyebrow">Pokedex Tracker</p>
      <h1 id="catchemall-title">Catch 'em all</h1>
      <p>wannab's active dexes, updated from Pokedex Tracker.</p>
    </header>

    <section aria-live="polite" aria-busy="true" id="dexes">
      <p class="catchemall__status">Loading dexes...</p>
    </section>
  </main>

  <template id="dex-panel-template">
    <article class="dex-panel">
      <div class="dex-card__heading">
        <p class="dex-card__game"></p>
        <h2></h2>
      </div>
      <p class="dex-card__type"></p>
      <div class="dex-card__progress">
        <div class="dex-card__counts">
          <span class="dex-card__caught"></span>
          <span class="dex-card__percent"></span>
        </div>
        <div class="dex-card__track" aria-hidden="true">
          <span></span>
        </div>
      </div>
      <dl class="dex-panel__stats">
        <div>
          <dt>Remaining</dt>
          <dd class="dex-panel__remaining"></dd>
        </div>
        <div>
          <dt>Tracker</dt>
          <dd class="dex-panel__tracker"></dd>
        </div>
      </dl>
    </article>
  </template>

  <template id="region-card-template">
    <details class="region-card">
      <summary>
        <span class="region-card__identity">
          <span class="region-card__title"></span>
          <span class="region-card__generation"></span>
        </span>
        <span class="region-card__count">
          <strong class="region-card__counts"></strong>
          <small>caught</small>
        </span>
        <span class="region-card__percent"></span>
      </summary>
      <div class="region-card__body">
        <div class="region-card__track" aria-hidden="true">
          <span></span>
        </div>
        <p></p>
        <div class="region-card__filters" role="group" aria-label="Filter Pokémon">
          <button type="button" data-filter="all" aria-pressed="true">
            All
          </button>
          <button type="button" data-filter="caught" aria-pressed="false">
            Caught
          </button>
          <button type="button" data-filter="missing" aria-pressed="false">
            Missing
          </button>
        </div>
        <ul class="region-card__pokemon"></ul>
      </div>
    </details>
  </template>

  <script>
    type Dex = {
      title: string;
      caught: number;
      total: number;
      shiny: boolean;
      slug?: string;
      dex_type?: { name?: string };
      game?: { name?: string };
    };

    type User = { dexes?: Dex[] };
    type Capture = {
      captured: boolean;
      pokemon: {
        dex_number?: number;
        form?: string | null;
        game_family?: { generation?: number };
        name: string;
      };
    };

    const regions = new Map([
      [1, "Kanto"],
      [2, "Johto"],
      [3, "Hoenn"],
      [4, "Sinnoh"],
      [5, "Unova"],
      [6, "Kalos"],
      [7, "Alola"],
      [8, "Galar"],
      [9, "Paldea"],
    ]);

    const container = document.querySelector<HTMLElement>("#dexes");
    const template = document.querySelector<HTMLTemplateElement>("#dex-panel-template");
    const regionCardTemplate = document.querySelector<HTMLTemplateElement>("#region-card-template");

    const renderStatus = (message: string) => {
      if (container) container.innerHTML = `<p class="catchemall__status">${message}</p>`;
    };

    const renderRegions = (captures: Capture[], target: HTMLElement) => {
      if (!regionCardTemplate) return;

      const section = document.createElement("section");
      section.className = "region-collection";
      section.setAttribute("aria-label", "Collection by region");
      const heading = document.createElement("h3");
      heading.textContent = "Collection by region";
      section.append(heading);

      const grouped = new Map<number, Capture[]>();
      for (const capture of captures) {
        const generation = capture.pokemon.game_family?.generation;
        if (!generation || !regions.has(generation)) continue;
        grouped.set(generation, [...(grouped.get(generation) ?? []), capture]);
      }

      for (const [generation, name] of regions) {
        const collection = grouped.get(generation);
        if (!collection?.length) continue;
        const caught = collection.filter(({ captured }) => captured).length;
        const total = collection.length;
        const percentage = Math.round((caught / total) * 100);
        const card = regionCardTemplate.content.cloneNode(true) as DocumentFragment;
        const title = card.querySelector<HTMLElement>(".region-card__title");
        const regionGeneration = card.querySelector<HTMLElement>(".region-card__generation");
        const counts = card.querySelector<HTMLElement>(".region-card__counts");
        const percent = card.querySelector<HTMLElement>(".region-card__percent");
        const progress = card.querySelector<HTMLElement>(".region-card__track span");
        const details = card.querySelector<HTMLElement>(".region-card__body p");
        const filters = card.querySelector<HTMLElement>(".region-card__filters");
        const pokemonList = card.querySelector<HTMLUListElement>(".region-card__pokemon");
        if (title) title.textContent = name;
        if (regionGeneration) regionGeneration.textContent = `Generation ${generation}`;
        if (counts) counts.textContent = `${caught} / ${total}`;
        if (percent) percent.textContent = `${percentage}%`;
        if (progress) progress.style.width = `${percentage}%`;
        if (details) details.textContent = `${total - caught} remaining`;
        if (filters && pokemonList) {
          const renderPokemon = (filter: "all" | "caught" | "missing") => {
            pokemonList.replaceChildren();
            const visible = collection.filter(({ captured }) =>
              filter === "all" ? true : filter === "caught" ? captured : !captured
            );
            for (const capture of visible) {
              const item = document.createElement("li");
              item.className = capture.captured
                ? "region-card__pokemon--caught"
                : "region-card__pokemon--missing";
              item.setAttribute(
                "aria-label",
                `${capture.pokemon.name}, ${capture.captured ? "caught" : "missing"}`
              );
              const status = document.createElement("span");
              status.className = "region-card__pokemon-status";
              status.setAttribute("aria-hidden", "true");
              status.textContent = capture.captured ? "✓" : "○";
              const name = document.createElement("span");
              const number = String(capture.pokemon.dex_number ?? "?").padStart(4, "0");
              name.textContent = `#${number} ${capture.pokemon.name}${
                capture.pokemon.form ? ` (${capture.pokemon.form})` : ""
              }`;
              item.append(status, name);
              pokemonList.append(item);
            }
          };
          for (const button of filters.querySelectorAll<HTMLButtonElement>("button")) {
            button.addEventListener("click", () => {
              const filter = button.dataset.filter as "all" | "caught" | "missing";
              for (const option of filters.querySelectorAll<HTMLButtonElement>("button")) {
                option.setAttribute("aria-pressed", String(option === button));
              }
              renderPokemon(filter);
            });
          }
          renderPokemon("all");
        }
        section.append(card);
      }
      target.append(section);
    };

    const renderDexes = (dexes: Dex[]) => {
      if (!container || !template) return;

      container.replaceChildren();
      container.setAttribute("aria-busy", "false");

      if (dexes.length === 0) {
        renderStatus("No dexes found.");
        return;
      }

      const tabList = document.createElement("div");
      tabList.className = "dex-tabs";
      tabList.setAttribute("role", "tablist");
      tabList.setAttribute("aria-label", "Dexes");
      const panel = document.createElement("div");
      panel.className = "dex-panel-wrap";
      panel.id = "selected-dex";
      panel.setAttribute("role", "tabpanel");

      const selectDex = (index: number, focus = false) => {
        const dex = dexes[index];
        const percentage = dex.total > 0 ? Math.round((dex.caught / dex.total) * 100) : 0;
        const dexPanel = template.content.cloneNode(true) as DocumentFragment;
        const title = dexPanel.querySelector("h2");
        const game = dexPanel.querySelector<HTMLElement>(".dex-card__game");
        const type = dexPanel.querySelector<HTMLElement>(".dex-card__type");
        const caught = dexPanel.querySelector<HTMLElement>(".dex-card__caught");
        const percent = dexPanel.querySelector<HTMLElement>(".dex-card__percent");
        const progress = dexPanel.querySelector<HTMLElement>(".dex-card__track span");
        const remaining = dexPanel.querySelector<HTMLElement>(".dex-panel__remaining");
        const tracker = dexPanel.querySelector<HTMLElement>(".dex-panel__tracker");

        if (title) title.textContent = dex.title;
        if (game) game.textContent = dex.game?.name ?? "Unknown game";
        if (type) type.textContent = `${dex.dex_type?.name ?? "Dex"}${dex.shiny ? " · Shiny" : ""}`;
        if (caught)
          caught.textContent = `${dex.caught.toLocaleString()} / ${dex.total.toLocaleString()} caught`;
        if (percent) percent.textContent = `${percentage}%`;
        if (progress) progress.style.width = `${Math.min(percentage, 100)}%`;
        if (remaining) remaining.textContent = Math.max(dex.total - dex.caught, 0).toLocaleString();
        if (tracker) tracker.textContent = dex.shiny ? "Shiny" : "Standard";

        panel.replaceChildren(dexPanel);
        panel.setAttribute("aria-labelledby", `dex-tab-${index}`);
        for (const [tabIndex, tab] of [
          ...tabList.querySelectorAll<HTMLButtonElement>("[role=tab]"),
        ].entries()) {
          const selected = tabIndex === index;
          tab.setAttribute("aria-selected", String(selected));
          tab.tabIndex = selected ? 0 : -1;
          if (selected && focus) tab.focus();
        }

        const regionsTarget = panel.querySelector<HTMLElement>(".dex-panel");
        if (regionsTarget) {
          const status = document.createElement("p");
          status.className = "region-collection__status";
          status.textContent = "Loading collection by region...";
          regionsTarget.append(status);
          fetch(`/catchemall/captures/${encodeURIComponent(dex.slug ?? "")}/`, {
            headers: { Accept: "application/json" },
          })
            .then((response) => {
              if (!response.ok) throw new Error("Unable to load captures");
              return response.json() as Promise<Capture[]>;
            })
            .then((captures) => {
              status.remove();
              renderRegions(captures, regionsTarget);
            })
            .catch(() => {
              status.textContent = "Collection by region is unavailable right now.";
            });
        }
      };

      dexes.forEach((dex, index) => {
        const tab = document.createElement("button");
        tab.className = "dex-tabs__tab";
        tab.type = "button";
        tab.id = `dex-tab-${index}`;
        tab.textContent = dex.title;
        tab.setAttribute("role", "tab");
        tab.setAttribute("aria-controls", "selected-dex");
        tab.setAttribute("aria-selected", String(index === 0));
        tab.tabIndex = index === 0 ? 0 : -1;
        tab.addEventListener("click", () => selectDex(index));
        tab.addEventListener("keydown", (event) => {
          const direction =
            event.key === "ArrowRight" || event.key === "ArrowDown"
              ? 1
              : event.key === "ArrowLeft" || event.key === "ArrowUp"
                ? -1
                : 0;
          if (!direction) return;
          event.preventDefault();
          selectDex((index + direction + dexes.length) % dexes.length, true);
        });
        tabList.append(tab);
      });

      container.append(tabList, panel);
      selectDex(0);
    };

    fetch("/catchemall/dexes/", { headers: { Accept: "application/json" } })
      .then((response) => {
        if (!response.ok) throw new Error("Unable to load dexes");
        return response.json() as Promise<User>;
      })
      .then((user) => renderDexes(user.dexes ?? []))
      .catch(() => {
        if (container) container.setAttribute("aria-busy", "false");
        renderStatus("The dexes are unavailable right now. Please try again shortly.");
      });
  </script>
  <style>
    .catchemall-layout {
      flex: 1;
      width: 100%;
    }

    .catchemall {
      width: min(100% - 2 * var(--page-pad), var(--content-wide));
      margin: 0 auto;
      padding: clamp(2.5rem, 7vw, 5rem) 0 5rem;
    }

    .catchemall__header {
      margin-bottom: 2rem;
    }

    .catchemall__eyebrow,
    .dex-card__game,
    .dex-card__type,
    .dex-card__percent {
      margin: 0;
      color: var(--color-muted);
      font-family: var(--font-mono);
      font-size: 0.78rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .catchemall h1 {
      margin: 0.35rem 0;
      font-family: var(--font-display);
      font-size: clamp(2.5rem, 8vw, 4.75rem);
      font-weight: 600;
      letter-spacing: -0.045em;
      line-height: 1;
    }

    .catchemall__header > p:last-child {
      margin: 0;
      color: var(--color-muted);
    }

    .catchemall__status {
      margin: 0;
      padding: 1.25rem;
      color: var(--color-muted);
      border: 1px solid var(--color-stroke);
      border-radius: var(--radius);
      background: color-mix(in srgb, var(--color-surface-2) 55%, transparent);
    }

    .dex-tabs {
      display: flex;
      gap: 0.5rem;
      overflow-x: auto;
      padding-bottom: 0.75rem;
    }

    .dex-tabs__tab {
      flex: 0 0 auto;
      padding: 0.65rem 1rem;
      border: 1px solid var(--color-stroke);
      border-radius: var(--radius-pill);
      color: var(--color-muted);
      background: transparent;
      font: inherit;
      cursor: pointer;
    }

    .dex-tabs__tab[aria-selected="true"] {
      color: var(--color-on-accent);
      border-color: var(--color-accent);
      background: var(--color-accent);
    }

    .dex-tabs__tab:focus-visible {
      outline: 2px solid var(--color-ink);
      outline-offset: 3px;
    }

    .dex-panel {
      display: grid;
      gap: 1.5rem;
      padding: 1.35rem;
      border: 1px solid var(--color-stroke);
      border-radius: var(--radius);
      background: color-mix(in srgb, var(--color-surface-2) 66%, transparent);
      box-shadow: var(--shadow-soft);
    }

    .dex-panel__stats {
      display: grid;
      gap: 1rem;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin: 0;
      padding-top: 1.25rem;
      border-top: 1px solid var(--color-stroke);
    }

    .dex-panel__stats div {
      display: grid;
      gap: 0.15rem;
    }

    .dex-panel__stats dt {
      color: var(--color-muted);
      font-size: 0.82rem;
    }

    .dex-panel__stats dd {
      margin: 0;
      font-family: var(--font-mono);
    }

    .dex-card__heading {
      display: grid;
      gap: 0.3rem;
    }

    .dex-card h2 {
      margin: 0;
      font-family: var(--font-display);
      font-size: 1.7rem;
      line-height: 1.1;
    }

    .dex-card__progress {
      display: grid;
      gap: 0.55rem;
    }

    .dex-card__counts {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      font-size: 0.95rem;
    }

    .dex-card__track {
      height: 0.55rem;
      overflow: hidden;
      border-radius: var(--radius-pill);
      background: color-mix(in srgb, var(--color-ink) 12%, transparent);
    }

    .dex-card__track span {
      display: block;
      height: 100%;
      border-radius: inherit;
      background: var(--color-accent);
    }

    .region-collection {
      display: grid;
      gap: 0.6rem;
      padding-top: 1.25rem;
      border-top: 1px solid var(--color-stroke);
    }

    .region-collection h3 {
      margin: 0 0 0.1rem;
      font-family: var(--font-display);
      font-size: 1.2rem;
    }

    .region-collection__status {
      margin: 0;
      color: var(--color-muted);
      font-size: 0.9rem;
    }

    .region-card {
      border: 1px solid var(--color-stroke);
      border-radius: 0.9rem;
      background: color-mix(in srgb, var(--color-surface) 82%, transparent);
      transition:
        border-color 160ms ease,
        box-shadow 160ms ease,
        background 160ms ease;
    }

    .region-card:hover {
      border-color: color-mix(in srgb, var(--color-accent) 38%, var(--color-stroke));
      background: var(--color-surface);
    }

    .region-card[open] {
      border-color: color-mix(in srgb, var(--color-accent) 58%, var(--color-stroke));
      box-shadow: 0 0.5rem 1.75rem color-mix(in srgb, var(--color-ink) 8%, transparent);
    }

    .region-card summary {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto 3.5rem 1rem;
      gap: 1rem;
      align-items: center;
      min-height: 4.5rem;
      padding: 0.75rem 1rem 0.75rem 1.15rem;
      cursor: pointer;
      list-style: none;
    }

    .region-card summary::-webkit-details-marker {
      display: none;
    }

    .region-card summary::before {
      content: "⌄";
      grid-column: 4;
      grid-row: 1;
      justify-self: end;
      color: var(--color-muted);
      font-family: var(--font-mono);
      font-size: 1.1rem;
      transition: transform 160ms ease;
    }

    .region-card[open] summary::before {
      transform: rotate(180deg);
    }

    .region-card__identity {
      display: grid;
      gap: 0.1rem;
    }

    .region-card__title {
      font-weight: 600;
      font-size: 1rem;
    }

    .region-card__generation,
    .region-card__count small {
      color: var(--color-muted);
      font-size: 0.75rem;
    }

    .region-card__counts,
    .region-card__percent {
      font-family: var(--font-mono);
      font-size: 0.82rem;
    }

    .region-card__count {
      display: grid;
      gap: 0.05rem;
      text-align: right;
    }

    .region-card__count small {
      font-family: var(--font-mono);
    }

    .region-card__percent {
      justify-self: end;
      min-width: 3.1rem;
      padding: 0.35rem 0.45rem;
      color: var(--color-accent);
      border-radius: var(--radius-pill);
      background: color-mix(in srgb, var(--color-accent) 11%, transparent);
      text-align: center;
    }

    .region-card__body {
      display: grid;
      gap: 0.8rem;
      padding: 0 1.15rem 1.15rem;
    }

    .region-card__track {
      height: 0.4rem;
      overflow: hidden;
      border-radius: var(--radius-pill);
      background: color-mix(in srgb, var(--color-ink) 12%, transparent);
    }

    .region-card__track span {
      display: block;
      height: 100%;
      border-radius: inherit;
      background: var(--color-accent);
    }

    .region-card__body p {
      margin: 0;
      color: var(--color-muted);
      font-size: 0.82rem;
    }

    .region-card__filters {
      display: flex;
      width: fit-content;
      overflow: hidden;
      border: 1px solid var(--color-stroke);
      border-radius: var(--radius-pill);
    }

    .region-card__filters button {
      padding: 0.38rem 0.7rem;
      border: 0;
      border-right: 1px solid var(--color-stroke);
      color: var(--color-muted);
      background: transparent;
      font: inherit;
      font-size: 0.8rem;
      cursor: pointer;
    }

    .region-card__filters button:last-child {
      border-right: 0;
    }

    .region-card__filters button[aria-pressed="true"] {
      color: var(--color-on-accent);
      border-color: var(--color-accent);
      background: var(--color-accent);
    }

    .region-card__filters button:focus-visible {
      outline: 2px solid var(--color-ink);
      outline-offset: 2px;
    }

    .region-card__pokemon {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
      gap: 0.4rem;
      max-height: min(50vh, 28rem);
      margin: 0;
      padding: 0;
      list-style: none;
      overflow: auto;
      scrollbar-color: var(--color-stroke) transparent;
    }

    .region-card__pokemon li {
      display: grid;
      grid-template-columns: 1.15rem minmax(0, 1fr);
      gap: 0.35rem;
      align-items: center;
      padding: 0.48rem 0.55rem;
      border: 1px solid transparent;
      border-radius: 0.45rem;
      background: color-mix(in srgb, var(--color-ink) 4%, transparent);
      font-size: 0.84rem;
      line-height: 1.25;
    }

    .region-card__pokemon-status {
      display: grid;
      width: 1.15rem;
      height: 1.15rem;
      place-items: center;
      border-radius: 50%;
      font-family: var(--font-mono);
      font-size: 0.73rem;
      font-weight: 700;
    }

    .region-card__pokemon--caught {
      color: var(--color-ink);
      border-color: color-mix(in srgb, var(--color-accent) 23%, transparent);
      background: color-mix(in srgb, var(--color-accent) 9%, var(--color-surface));
    }

    .region-card__pokemon--caught .region-card__pokemon-status {
      color: var(--color-on-accent);
      background: var(--color-accent);
    }

    .region-card__pokemon--missing {
      color: var(--color-muted);
      border-color: color-mix(in srgb, var(--color-stroke) 75%, transparent);
      background: transparent;
    }

    .region-card__pokemon--missing .region-card__pokemon-status {
      color: var(--color-muted);
      border: 1px solid currentColor;
    }

    @media (max-width: 34rem) {
      .region-card summary {
        grid-template-columns: minmax(0, 1fr) auto 2.7rem 1rem;
        gap: 0.6rem;
      }

      .region-card__count {
        display: none;
      }

      .region-card__pokemon {
        grid-template-columns: 1fr;
      }
    }
  </style>
</SiteLayout>
